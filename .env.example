# Browser auth (public Supabase values used by the existing Productiv UI)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server auth (same Supabase project; never commit real values)
SUPABASE_URL=
SUPABASE_ANON_KEY=

PORT=8788
PRODUCTIV_DB_PATH=/app/data/productiv.db
PRODUCTIV_TIMEZONE=America/New_York
PRODUCTIV_CHECKIN_HOUR=8
PRODUCTIV_CHECKOUT_HOUR=19
# Comma-separated browser origins if UI/API are on different origins. Same-origin needs none.
PRODUCTIV_ALLOWED_ORIGINS=
# Optional comma-separated Origin allow-list for browser-based MCP clients.
PRODUCTIV_MCP_ALLOWED_ORIGINS=

# Connector secrets are resolved by reference. Example only; do not put values in source control.
# VIVIENNE_BASE44_TOKEN=
# HERMES_MANAGED_TOKEN=
